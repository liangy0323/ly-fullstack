# 必须指向本机、名称包含 e2e/test/ci 的独立 PostgreSQL 数据库
E2E_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/ly_fullstack_e2e?schema=public

# seed 管理员账号；密码必须与测试数据库首次 seed 使用的值一致
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=change-me

# 可选：默认使用 18081、13000、13001，且禁止与开发端口重复
# E2E_ADMIN_PORT=18081
# E2E_ADMIN_API_PORT=13000
# E2E_API_PORT=13001
